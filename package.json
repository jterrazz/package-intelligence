{
    "name": "@jterrazz/intelligence",
    "version": "8.0.0",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/jterrazz/package-intelligence"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./formatting": {
            "import": {
                "types": "./dist/formatting.d.ts",
                "default": "./dist/formatting.js"
            },
            "require": {
                "types": "./dist/formatting.d.cts",
                "default": "./dist/formatting.cjs"
            }
        },
        "./oxlint": {
            "types": "./dist/oxlint.d.ts",
            "default": "./dist/oxlint.js"
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "typescript build",
        "docs": "npm run build && node .artifacts/dev/chapters.js",
        "generate:terms": "node scripts/generate-preserved-terms.ts && oxfmt src/formatting/preserved-terms.generated.ts",
        "lint": "typescript check",
        "lint:fix": "typescript fix",
        "test": "vitest --run"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.14",
        "@ai-sdk/otel": "^1.0.31",
        "@jterrazz/telemetry": "^1.1.0",
        "@openrouter/ai-sdk-provider": "^3.0.0",
        "@opentelemetry/api": "^1.9.1",
        "@types/json-schema": "^7.0.15",
        "dictionary-en": "^4.0.0",
        "dictionary-fr": "^3.0.0",
        "nspell": "^2.1.5"
    },
    "devDependencies": {
        "@ai-sdk/provider": "^4.0.3",
        "@cspell/dict-companies": "^3.2.12",
        "@cspell/dict-software-terms": "^5.2.4",
        "@jterrazz/test": "^17.0.0",
        "@jterrazz/typescript": "^11.0.0",
        "@opentelemetry/context-async-hooks": "^2.12.0",
        "@opentelemetry/sdk-trace-base": "^2.12.0",
        "@types/node": "^26.1.1",
        "@types/nspell": "^2.1.6",
        "ai": "^7.0.28",
        "vitest": "^5.0.1",
        "zod": "^4.6.5"
    },
    "peerDependencies": {
        "@jterrazz/typescript": "^11.0.0",
        "ai": ">=7.0.0"
    },
    "peerDependenciesMeta": {
        "@jterrazz/typescript": {
            "optional": true
        },
        "ai": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24"
    }
}
